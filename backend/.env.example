# ============================================================
# MEDNEXUS AI — BACKEND ENVIRONMENT CONFIGURATION
# ============================================================

# Server Port (Defaults to 5000)
PORT=5000

# Node Environment
NODE_ENV=production

# Frontend URL(s) for CORS (comma-separated for multiple origins)
# Example: FRONTEND_URL=http://localhost:5173,https://mednexus-ai.vercel.app
FRONTEND_URL=*

# PostgreSQL Database Connection String (e.g., Neon / Supabase / AWS RDS / Local)
# Cloud Example: postgresql://username:password@ep-xyz.region.aws.neon.tech/mednexus?sslmode=require
# Local Example: postgresql://postgres:password@localhost:5432/mednexus
DATABASE_URL=postgresql://postgres:password@localhost:5432/mednexus

# SSL Mode (Set to true if connecting to cloud PostgreSQL like Neon/Supabase)
DB_SSL=true

# JWT Authentication Secret Key (Any long secure random string)
JWT_SECRET=your_super_secret_jwt_key_mednexus_2026

# Groq AI Clinical Copilot & Triage Engine
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional SMTP Email Configuration (For live real-time OTP delivery)
# If omitted, OTPs will be securely delivered via simulated server logs
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
