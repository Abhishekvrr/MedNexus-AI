# MedNexus AI - Backend Environment Configuration

# Server Port
PORT=5000

# Frontend URL(s) for CORS (comma-separated if multiple, e.g. http://localhost:5173,https://your-app.vercel.app)
FRONTEND_URL=http://localhost:5173,https://mednexus-ai.vercel.app

# PostgreSQL Database Connection String
# For local: postgresql://username:password@localhost:5432/mednexus
# For cloud (Neon/Supabase/Render): postgresql://user:password@ep-xyz.region.aws.neon.tech/mednexus?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/mednexus

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_mednexus_2026

# Groq AI Clinical Copilot & Triage Engine
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
